# LLM API Configuration
# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Provider Selection: "openai" | "anthropic" | "mock" (auto-detected if key is set)
LLM_PROVIDER=auto

# Service Port & Host
HOST=0.0.0.0
PORT=8000

# Backend Integration (optional: set if pulling live data from ASP.NET Core)
BACKEND_BASE_URL=http://localhost:5077/api
